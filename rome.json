{
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "a11y": {
        "useAltText": "off"
      }
    },
    "ignore": ["node_modules", ".next", "dist", ".contentlayer"]
  },
  "formatter": {
    "ignore": ["node_modules", ".next", "dist", ".contentlayer"]
  }
}
